# Copy this file to .env and fill in the keys you have.
# .env is gitignored — never commit real keys.

# Which LLM provider to use: gemini | anthropic | groq
LLM_PROVIDER=gemini

# Gemini — free tier, get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Anthropic — paid, get key at https://console.anthropic.com (separate from Claude Pro)
ANTHROPIC_API_KEY=

# Groq — free tier, fast inference on open-weight models, https://console.groq.com
GROQ_API_KEY=

# Optional: override default model names per provider
# GEMINI_MODEL=gemini-2.5-pro
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GROQ_MODEL=llama-3.3-70b-versatile
